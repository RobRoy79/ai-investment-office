
"""
AI Investment Office
Fundamental Analyzer – Version 1.0

Analyses company fundamentals using Yahoo Finance data.
Research and paper analysis only. No real trades.
"""

import yfinance as yf


def safe_number(value):
    """Convert a value to a usable number, or return None."""
    try:
        if value is None:
            return None

        number = float(value)

        if number != number:  # NaN check
            return None

        return number

    except (TypeError, ValueError):
        return None


def score_quality(info):
    """Score business quality using available financial metrics."""

    scores = []
    possible = []

    def add_score(value, maximum, points):
        if value is not None:
            scores.append(points)
            possible.append(maximum)

    revenue_growth = safe_number(info.get("revenueGrowth"))
    profit_margin = safe_number(info.get("profitMargins"))
    operating_margin = safe_number(info.get("operatingMargins"))
    return_on_equity = safe_number(info.get("returnOnEquity"))
    debt_to_equity = safe_number(info.get("debtToEquity"))
    current_ratio = safe_number(info.get("currentRatio"))
    free_cash_flow = safe_number(info.get("freeCashflow"))

    # Revenue growth
    if revenue_growth is not None:
        points = (
            15 if revenue_growth >= 0.15 else
            10 if revenue_growth >= 0.05 else
            5 if revenue_growth >= 0 else 0
        )
        add_score(revenue_growth, 15, points)

    # Profit margin
    if profit_margin is not None:
        points = (
            15 if profit_margin >= 0.15 else
            10 if profit_margin >= 0.08 else
            5 if profit_margin > 0 else 0
        )
        add_score(profit_margin, 15, points)

    # Operating margin
    if operating_margin is not None:
        points = (
            15 if operating_margin >= 0.15 else
            10 if operating_margin >= 0.08 else
            5 if operating_margin > 0 else 0
        )
        add_score(operating_margin, 15, points)

    # Return on equity
    if return_on_equity is not None:
        points = (
            15 if return_on_equity >= 0.15 else
            10 if return_on_equity >= 0.08 else
            5 if return_on_equity > 0 else 0
        )
        add_score(return_on_equity, 15, points)

    # Debt compared with equity.
    # Yahoo normally reports this as a percentage.
    if debt_to_equity is not None:
        points = (
            15 if debt_to_equity <= 50 else
            10 if debt_to_equity <= 100 else
            5 if debt_to_equity <= 200 else 0
        )
        add_score(debt_to_equity, 15, points)

    # Short-term financial strength
    if current_ratio is not None:
        points = (
            10 if current_ratio >= 1.5 else
            7 if current_ratio >= 1.0 else
            3 if current_ratio >= 0.8 else 0
        )
        add_score(current_ratio, 10, points)

    # Free cash flow
    if free_cash_flow is not None:
        points = 15 if free_cash_flow > 0 else 0
        add_score(free_cash_flow, 15, points)

    if not possible:
        return None, 0

    score = round(sum(scores) / sum(possible) * 100)

    return score, len(possible)


def score_valuation(info):
    """A preliminary valuation score. Not a fair-value calculation."""

    scores = []
    possible = []

    pe = safe_number(info.get("trailingPE"))
    ps = safe_number(info.get("priceToSalesTrailing12Months"))
    ev_ebitda = safe_number(info.get("enterpriseToEbitda"))

    # Trailing P/E
    if pe is not None and pe > 0:
        points = (
            20 if pe <= 15 else
            15 if pe <= 25 else
            8 if pe <= 35 else 3
        )
        scores.append(points)
        possible.append(20)

    # Price / Sales
    if ps is not None and ps > 0:
        points = (
            15 if ps <= 2 else
            10 if ps <= 5 else
            5 if ps <= 10 else 0
        )
        scores.append(points)
        possible.append(15)

    # Enterprise Value / EBITDA
    if ev_ebitda is not None and ev_ebitda > 0:
        points = (
            15 if ev_ebitda <= 10 else
            10 if ev_ebitda <= 18 else
            5 if ev_ebitda <= 25 else 0
        )
        scores.append(points)
        possible.append(15)

    if not possible:
        return None, 0

    score = round(sum(scores) / sum(possible) * 100)

    return score, len(possible)


def analyze_fundamentals(symbol):
    """
    Analyse one company's available fundamental information.

    Missing data is not treated as a bad result.
    """

    try:
        ticker = yf.Ticker(symbol)
        info = ticker.info

        if not isinstance(info, dict) or not info:
            return {
                "symbol": symbol,
                "success": False,
                "message": "Ingen bolagsinformation kunde hämtas."
            }

        quality_score, quality_metrics = score_quality(info)
        valuation_score, valuation_metrics = score_valuation(info)

        available_scores = []
        if quality_score is not None:
            available_scores.append((quality_score, 0.70))

        if valuation_score is not None:
            available_scores.append((valuation_score, 0.30))

        if available_scores:
            total_weight = sum(weight for _, weight in available_scores)
            fundamental_score = round(
                sum(score * weight for score, weight in available_scores)
                / total_weight
            )
        else:
            fundamental_score = None

        total_metrics = quality_metrics + valuation_metrics

        if total_metrics < 3:
            classification = "Otillräckligt underlag"
        elif fundamental_score >= 75:
            classification = "Stark fundamental profil"
        elif fundamental_score >= 55:
            classification = "Intressant för vidare analys"
        else:
            classification = "Svag eller osäker profil"

        return {
            "symbol": symbol,
            "success": True,
            "company": (
                info.get("shortName")
                or info.get("longName")
                or symbol
            ),
            "sector": info.get("sector"),
            "industry": info.get("industry"),
            "market_cap": safe_number(info.get("marketCap")),
            "currency": info.get("currency"),
            "revenue_growth": safe_number(info.get("revenueGrowth")),
            "profit_margin": safe_number(info.get("profitMargins")),
            "operating_margin": safe_number(info.get("operatingMargins")),
            "return_on_equity": safe_number(info.get("returnOnEquity")),
            "debt_to_equity": safe_number(info.get("debtToEquity")),
            "current_ratio": safe_number(info.get("currentRatio")),
            "free_cash_flow": safe_number(info.get("freeCashflow")),
            "trailing_pe": safe_number(info.get("trailingPE")),
            "forward_pe": safe_number(info.get("forwardPE")),
            "price_to_sales": safe_number(
                info.get("priceToSalesTrailing12Months")
            ),
            "ev_to_ebitda": safe_number(info.get("enterpriseToEbitda")),
            "quality_score": quality_score,
            "valuation_score": valuation_score,
            "fundamental_score": fundamental_score,
            "available_metrics": total_metrics,
            "classification": classification,
            "message": (
                "Preliminär fundamental analys. "
                "Poängen är ett internt urvalsverktyg, "
                "inte en rekommendation eller beräkning av verkligt värde."
            ),
        }

    except Exception as error:
        return {
            "symbol": symbol,
            "success": False,
            "message": str(error)
        }


# --------------------------------------------------
# ANALYSE MULTIPLE COMPANIES
# --------------------------------------------------

def analyze_multiple_fundamentals(symbols):
    results = []

    for symbol in symbols:
        result = analyze_fundamentals(symbol)
        results.append(result)

    successful = [
        item for item in results
        if item.get("success")
    ]

    successful.sort(
        key=lambda item: (
            item["fundamental_score"]
            if item["fundamental_score"] is not None
            else -1
        ),
        reverse=True
    )

    failed = [
        item for item in results
        if not item.get("success")
    ]

    return {
        "analysed": len(results),
        "successful": len(successful),
        "failed": len(failed),
        "results": successful,
        "errors": failed,
        "status": "PAPER ANALYSIS ONLY - NO REAL TRADES",
    }
